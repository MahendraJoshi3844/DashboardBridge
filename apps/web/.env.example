# The API gateway the browser talks to. In Local/air-gapped mode this is a
# loopback address and nothing else is ever contacted (ADR-006, §51).
NEXT_PUBLIC_API_URL=http://localhost:8000

# Mirrors MAX_UPLOAD_SIZE_MB on the gateway, so the browser can refuse a file
# the service would refuse anyway. The browser's copy is a courtesy: the server
# re-checks the declared size and the streamed bytes, and its answer is the one
# that counts (see src/lib/upload/precheck.ts).
NEXT_PUBLIC_MAX_UPLOAD_MB=500
