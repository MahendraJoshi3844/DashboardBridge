{
  "name": "@dashboardbridge/web",
  "version": "0.1.0",
  "private": true,
  "description": "DashboardBridge AI — web shell. Thin by design: no conversion logic lives here.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "gen:types": "node scripts/gen-types.mjs",
    "check:contrast": "node scripts/check-contrast.mjs",
    "check:ordering": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/check-ordering.mjs",
    "shot": "node scripts/screenshot.mjs",
    "test": "vitest run"
  },
  "dependencies": {
    "motion": "^12.23.32",
    "next": "^15.5.7",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "autoprefixer": "^10.4.20",
    "json-schema-to-typescript": "^15.0.4",
    "postcss": "^8.4.49",
    "puppeteer-core": "^24.0.0",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.0",
    "vitest": "^3.2.7"
  }
}
