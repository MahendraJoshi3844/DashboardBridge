<?xml version='1.0' encoding='utf-8' ?>
<workbook version="18.1">
  <datasources>
    <datasource caption="Orders" inline='true' name="federated.orders" version="18.1">
      <connection class='federated'>
        <relation name="Orders" table="[Orders]" type='table' />
      </connection>
      <column caption="Order ID" datatype="string" name="[Order ID]" role="dimension" type="nominal" />
      <column caption="Region" datatype="string" name="[Region]" role="dimension" type="nominal" />
      <column caption="Profit" datatype="real" name="[Profit]" role="measure" type="quantitative" />
      <column caption="Sales" datatype="real" name="[Sales]" role="measure" type="quantitative" />
      <column caption="Quantity" datatype="integer" name="[Quantity]" role="measure" type="quantitative" />
      <column caption="Profit Ratio" datatype="real" name="[Profit Ratio]" role="measure" type="quantitative">
        <calculation class='tableau' formula="SUM([Profit]) / SUM([Sales])" />
      </column>
      <column caption="Units per Order" datatype="real" name="[Units per Order]" role="measure" type="quantitative">
        <calculation class='tableau' formula="SUM([Quantity]) / COUNTD([Order ID])" />
      </column>
      <column caption="Projected Sales" datatype="real" name="[Projected Sales]" role="measure" type="quantitative">
        <calculation class='tableau' formula="SUM([Sales]) * (1 + [Parameter 1])" />
      </column>
    </datasource>
    <datasource caption="Returns" inline='true' name="federated.returns" version="18.1">
      <connection class='federated'>
        <relation name="Returns" table="[Returns]" type='table' />
      </connection>
      <column caption="Return ID" datatype="string" name="[Return ID]" role="dimension" type="nominal" />
      <column caption="Return Count" datatype="integer" name="[Return Count]" role="measure" type="quantitative" />
      <column caption="Quantity" datatype="real" name="[Quantity]" role="measure" type="quantitative">
        <calculation class='tableau' formula="RUNNING_SUM(SUM([Return Count]))" />
      </column>
      <column caption="Return Rate" datatype="real" name="[Return Rate]" role="measure" type="quantitative">
        <calculation class='tableau' formula="[Quantity] * 1.0" />
      </column>
    </datasource>
    <datasource caption="Targets" inline='true' name="federated.targets" version="18.1">
      <connection class='federated'>
        <relation name="Targets" table="[Targets]" type='table' />
      </connection>
      <column caption="Region" datatype="string" name="[Region]" role="dimension" type="nominal" />
      <column caption="Quota" datatype="real" name="[Quota]" role="measure" type="quantitative" />
      <column caption="Sales" datatype="real" name="[Sales]" role="measure" type="quantitative">
        <calculation class='tableau' formula="SUM([Quota]) * 2" />
      </column>
      <column caption="Attainment" datatype="real" name="[Attainment]" role="measure" type="quantitative">
        <calculation class='tableau' formula="[Sales] / SUM([Quota])" />
      </column>
    </datasource>
  </datasources>
  <worksheets>
    <worksheet name="Attainment by Region">
      <!-- not carried: this worksheet reads Orders and Targets, which are not related in the source model, and Tableau binds one worksheet to one data source. Relate the tables and convert again, or rebuild the worksheet by hand -->
      <table>
        <view />
        <rows></rows>
        <cols></cols>
        <panes>
          <pane>
            <mark class="Bar" />
          </pane>
        </panes>
      </table>
    </worksheet>
    <worksheet name="Profit by Region">
      <table>
        <view />
        <rows>[federated.orders].[sum:Profit Ratio:qk]</rows>
        <cols>[federated.orders].[none:Region:nk]</cols>
        <panes>
          <pane>
            <mark class="Bar" />
          </pane>
        </panes>
      </table>
    </worksheet>
  </worksheets>
  <dashboards>
    <dashboard name="Clash Overview">
      <zones>
        <zone name="Profit by Region" />
        <zone name="Attainment by Region" />
      </zones>
    </dashboard>
  </dashboards>
</workbook>
