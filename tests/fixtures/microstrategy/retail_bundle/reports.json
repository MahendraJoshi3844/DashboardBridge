  {
    "name": "Top Products SQL",
    "type": "freeform_sql",
    "datasource": "Retail DW",
    "sql": "SELECT p.PRODUCT_DESC, SUM(f.REVENUE) AS REVENUE FROM FACT_SALES f JOIN LU_PRODUCT p ON p.PRODUCT_ID = f.PRODUCT_ID GROUP BY p.PRODUCT_DESC",
    "sqlColumns": [
      {
        "name": "PRODUCT_DESC",
        "dataType": "varchar"
      },
      {
        "name": "REVENUE",
        "dataType": "decimal"
      }
    ]
