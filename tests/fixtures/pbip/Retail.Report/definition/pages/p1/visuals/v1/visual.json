{
  "$schema": "https://developer.microsoft.com/json-schemas/fabric/item/report/definition/visualContainer/1.0.0/schema.json",
  "name": "v1",
  "position": { "x": 16, "y": 16, "z": 0, "width": 640, "height": 400, "tabOrder": 0 },
  "visual": {
    "visualType": "columnChart",
    "query": {
      "queryState": {
        "Category": {
          "projections": [
            {
              "field": {
                "Column": {
                  "Expression": { "SourceRef": { "Entity": "Store" } },
                  "Property": "Region"
                }
              },
              "queryRef": "Store.Region",
              "nativeQueryRef": "Region"
            }
          ]
        },
        "Y": {
          "projections": [
            {
              "field": {
                "Measure": {
                  "Expression": { "SourceRef": { "Entity": "Sales" } },
                  "Property": "Total Revenue"
                }
              },
              "queryRef": "Sales.Total Revenue",
              "nativeQueryRef": "Total Revenue"
            }
          ]
        },
        "Series": {
          "projections": [
            {
              "field": {
                "Column": {
                  "Expression": { "SourceRef": { "Entity": "Store" } },
                  "Property": "Store Name"
                }
              },
              "queryRef": "Store.Store Name",
              "nativeQueryRef": "Store Name"
            }
          ]
        }
      }
    },
    "objects": {
      "title": [
        {
          "properties": {
            "text": { "expr": { "Literal": { "Value": "'Revenue by Region'" } } }
          }
        }
      ]
    }
  },
  "filterConfig": {
    "filters": [
      {
        "name": "f1",
        "field": {
          "Column": {
            "Expression": { "SourceRef": { "Entity": "Sales" } },
            "Property": "Order Date"
          }
        },
        "type": "Advanced"
      }
    ]
  }
}
